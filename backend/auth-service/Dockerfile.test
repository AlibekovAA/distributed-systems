FROM base-test:latest AS base

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /bin/

WORKDIR /app

ENV PATH="/opt/venv/bin:$PATH" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=0

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-default-groups --group auth --group test

COPY backend/auth-service/ ./
ENV PYTHONPATH=/app

RUN echo '#!/bin/bash\n\
set -e\n\
pytest -v --alluredir=/app/allure-results' > /app/run_tests.sh && \
chmod +x /app/run_tests.sh

CMD ["/app/run_tests.sh"]
