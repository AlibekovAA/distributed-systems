FROM golang:1.22

WORKDIR /app

COPY go.mod go.sum ./

ENV GO111MODULE=on
ENV CGO_ENABLED=0
ENV GOPATH=/root/go
ENV PATH="${GOPATH}/bin:${PATH}"

RUN go mod download

RUN go install gotest.tools/gotestsum@v1.12.0

COPY src ./src

CMD ["sh", "-c", "gotestsum --format testname --junitfile /app/allure-results/go-test-report.xml -- ./src/... -v"]
